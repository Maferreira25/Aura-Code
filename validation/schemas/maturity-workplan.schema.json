{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuraCode Stable Maturity Workplan",
  "type": "object",
  "required": [
    "version",
    "target",
    "policy",
    "criteria"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "const": "stable-1.0"
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner_role",
          "independence_required",
          "human_required",
          "prerequisites",
          "validator",
          "evidence_package",
          "completion_condition",
          "next_action"
        ],
        "properties": {
          "id": {
            "pattern": "^MAT-[0-9]{2}$"
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          },
          "independence_required": {
            "type": "boolean"
          },
          "human_required": {
            "type": "boolean"
          },
          "prerequisites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validator": {
            "type": "string",
            "minLength": 1
          },
          "evidence_package": {
            "type": "string",
            "minLength": 1
          },
          "completion_condition": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
