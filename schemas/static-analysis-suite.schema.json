{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Maferreira25/Aura-Code/main/schemas/static-analysis-suite.schema.json",
  "title": "Aura Code Independent Static Analyzer Suite",
  "type": "object",
  "required": ["schema_version", "suite_id", "analyzers", "diversity"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "suite_id": {"type": "string", "pattern": "^STATIC-[A-Z0-9][A-Z0-9._-]*$"},
    "analyzers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "analyzer_id",
          "kind",
          "command",
          "sarif_output",
          "accepted_exit_codes",
          "timeout_seconds",
          "required"
        ],
        "properties": {
          "analyzer_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["semgrep", "codeql", "custom_sarif"]},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "sarif_output": {"type": "string", "minLength": 1},
          "accepted_exit_codes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer"},
            "uniqueItems": true
          },
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
          "required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "diversity": {
      "type": "object",
      "required": ["enabled", "line_tolerance"],
      "properties": {
        "enabled": {"type": "boolean"},
        "line_tolerance": {"type": "integer", "minimum": 0, "maximum": 10}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
