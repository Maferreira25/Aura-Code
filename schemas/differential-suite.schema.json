{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Maferreira25/Aura-Code/main/schemas/differential-suite.schema.json",
  "title": "Aura Code Differential Test Suite",
  "type": "object",
  "required": [
    "schema_version",
    "suite_id",
    "title",
    "requirements",
    "adapter",
    "candidate",
    "reference",
    "cases",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "suite_id": {"type": "string", "pattern": "^DIFF-[A-Z0-9][A-Z0-9._-]*$"},
    "title": {"type": "string", "minLength": 3},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "adapter": {"enum": ["python-callable"]},
    "candidate": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {}
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
  },
  "additionalProperties": false
}
