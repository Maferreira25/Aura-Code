{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Maferreira25/Aura-Code/main/schemas/differential-suite.schema.json",
  "title": "Aura Code Differential Test Suite",
  "type": "object",
  "required": [
    "schema_version",
    "suite_id",
    "requirements",
    "reference_command",
    "candidate_command",
    "cases",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "suite_id": {"type": "string", "pattern": "^DIFF-[A-Z0-9][A-Z0-9._-]*$"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reference_command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate_command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "cases": {
      "type": "array",
      "minItems": 1
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
  },
  "additionalProperties": false
}
