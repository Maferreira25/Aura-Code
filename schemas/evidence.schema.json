{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Maferreira25/Aura-Code/main/schemas/evidence.schema.json",
  "title": "Aura Code Assurance Evidence Record v2",
  "description": "Evidence bound to the exact evaluated source, workspace, configuration, ruleset and canonical assurance result.",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "control_id",
    "check_id",
    "type",
    "description",
    "producer",
    "timestamp",
    "location",
    "subject",
    "integrity",
    "freshness",
    "result"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-[0-9a-fA-F-]{36}$"
    },
    "control_id": {
      "type": ["string", "null"]
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": ["tool", "method", "independence"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": ["string", "null"]},
        "method": {"type": "string", "minLength": 1},
        "independence": {
          "enum": [
            "implementer-produced",
            "independent-agent",
            "deterministic-tool",
            "human-independent",
            "external-system"
          ]
        }
      },
      "additionalProperties": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "required": [
        "source_commit",
        "source_tree_hash",
        "workspace_hash",
        "artifact_digest",
        "config_hash",
        "ruleset_hash"
      ],
      "properties": {
        "source_commit": {"type": ["string", "null"]},
        "source_tree_hash": {"type": ["string", "null"]},
        "workspace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_digest": {"type": ["string", "null"]},
        "config_hash": {"type": ["string", "null"]},
        "ruleset_hash": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["result_sha256", "record_sha256"],
      "properties": {
        "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "freshness": {
      "enum": ["VALID", "STALE", "INVALID", "MISSING"]
    },
    "result": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
