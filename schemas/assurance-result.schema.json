{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Maferreira25/Aura-Code/main/schemas/assurance-result.schema.json",
  "title": "Aura Code Canonical Assurance Result",
  "description": "Canonical fail-closed result contract for all assurance evaluators. Evaluator-specific states must be normalized before influencing assurance decisions.",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "check_id",
    "status",
    "producer",
    "target",
    "execution",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "result_id": {
      "type": "string",
      "pattern": "^AR-[0-9a-fA-F-]{36}$"
    },
    "control_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{3}-[0-9]{2}$"
    },
    "check_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "NOT_TESTED",
        "NOT_APPLICABLE",
        "WAIVED",
        "ERROR",
        "STALE"
      ]
    },
    "severity": {
      "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "producer": {
      "type": "object",
      "required": ["tool", "method"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": ["string", "null"]},
        "method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["workspace"],
      "properties": {
        "workspace": {"type": "string", "minLength": 1},
        "source_commit": {"type": ["string", "null"]},
        "tree_hash": {"type": ["string", "null"]},
        "artifact_digest": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["started_at", "finished_at"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "exit_code": {"type": ["integer", "null"]},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "files_scanned": {"type": "integer", "minimum": 0},
        "languages": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {"type": "object"}
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "waiver": {
      "type": ["object", "null"]
    },
    "legacy": {
      "type": ["object", "null"]
    }
  },
  "additionalProperties": false
}
