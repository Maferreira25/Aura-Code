{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Maferreira25/Aura-Code/main/schemas/dast-suite.schema.json",
  "title": "Aura Code Local DAST Suite",
  "type": "object",
  "required": [
    "schema_version",
    "suite_id",
    "title",
    "requirements",
    "base_url",
    "checks",
    "timeout_seconds",
    "max_response_bytes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "suite_id": {"type": "string", "pattern": "^DAST-[A-Z0-9][A-Z0-9._-]*$"},
    "title": {"type": "string", "minLength": 3},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "base_url": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "path", "method", "expected_status", "required_headers"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^DAST-[A-Z0-9][A-Z0-9._-]*$"},
          "path": {"type": "string", "pattern": "^/"},
          "method": {"enum": ["GET", "HEAD"]},
          "expected_status": {"type": "integer", "minimum": 100, "maximum": 599},
          "required_headers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
    "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760}
  },
  "additionalProperties": false
}
