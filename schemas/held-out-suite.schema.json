{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Maferreira25/Aura-Code/main/schemas/held-out-suite.schema.json",
  "title": "Aura Code Held-Out Evaluation Suite",
  "type": "object",
  "required": [
    "schema_version",
    "suite_id",
    "title",
    "category",
    "requirements",
    "test_glob",
    "disclosure"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "suite_id": {
      "type": "string",
      "pattern": "^HO-[A-Z0-9][A-Z0-9._-]*$"
    },
    "title": {"type": "string", "minLength": 3},
    "category": {
      "enum": [
        "FUNCTIONAL",
        "SECURITY",
        "RELIABILITY",
        "PRIVACY",
        "DATA_INTEGRITY",
        "ARCHITECTURE",
        "OTHER"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "test_glob": {"type": "string", "minLength": 1},
    "disclosure": {
      "enum": ["CATEGORY_ONLY", "REQUIREMENT_ONLY"]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    }
  },
  "additionalProperties": false
}
