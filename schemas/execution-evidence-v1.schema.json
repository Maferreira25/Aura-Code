{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuraCode Execution Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "control_id",
    "verification_id",
    "commit",
    "scope",
    "tool",
    "tool_version",
    "command",
    "started_at",
    "finished_at",
    "status",
    "returncode",
    "stdout_hex",
    "stderr_hex",
    "stdout_sha256",
    "stderr_sha256",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "control_id": {
      "type": "string",
      "minLength": 1
    },
    "verification_id": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "scope": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "tool": {
      "const": "auracode-evidence"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "STALE"
      ]
    },
    "returncode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "stdout_hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "stderr_hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "stdout_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stderr_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
