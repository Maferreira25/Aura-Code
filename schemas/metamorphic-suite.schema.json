{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Maferreira25/Aura-Code/main/schemas/metamorphic-suite.schema.json",
  "title": "Aura Code Metamorphic Test Suite",
  "type": "object",
  "required": ["schema_version", "suite_id", "relations", "timeout_seconds"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "suite_id": {"type": "string", "pattern": "^MR-[A-Z0-9][A-Z0-9._-]*$"},
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relation_id", "requirement_id", "description", "test_target"],
        "properties": {
          "relation_id": {"type": "string", "pattern": "^MR-[A-Z0-9][A-Z0-9._-]*$"},
          "requirement_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 10},
          "test_target": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
  },
  "additionalProperties": false
}
